<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="post_warning_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_es_verifactu_checks.post_warning.form</field>
        <field name="model">l10n_es_verifactu_checks.post_warning</field>
        <field name="arch" type="xml">
            <form string="Confirmar emisión">
                <field name="message" readonly="1" nolabel="1" widget="text" class="o_wrap_text" colspan="4"/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
