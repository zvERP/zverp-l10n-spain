<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form_inherit_verifactu_enabled_groups" model="ir.ui.view">
        <field name="name">account.journal.form - verifactu enabled groups</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_es_verifactu_oca.view_account_journal_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='verifactu_enabled']" position="replace">
                <field
                    name="verifactu_enabled"
                    groups="base.group_system"
                    attrs="{'invisible': ['|', ('company_verifactu_enabled', '=', False), ('type', '!=', 'sale')]}"
                />
                <field
                    name="verifactu_enabled"
                    readonly="1"
                    groups="!base.group_system"
                    attrs="{'invisible': ['|', ('company_verifactu_enabled', '=', False), ('type', '!=', 'sale')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
